{
  "name": "cell-counter-desktop",
  "productName": "Cell Counter",
  "version": "1.0.0",
  "description": "Count cells in microscope photos and estimate live vs dead cells, on your own computer.",
  "homepage": "https://github.com/MertOnen-Research/cell-counter",
  "author": {
    "name": "Mert Önen",
    "email": "266734412+MertOnen-Research@users.noreply.github.com"
  },
  "private": true,
  "main": "main.js",
  "scripts": {
    "prepare-bundle": "node prepare.js",
    "start": "node prepare.js && electron .",
    "dist": "node prepare.js && electron-builder --publish never"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/space-grotesk": "5.3.0",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "jszip": "3.10.1",
    "onnxruntime-web": "1.30.0"
  },
  "build": {
    "appId": "io.github.mertonen-research.cellcounter",
    "productName": "Cell Counter",
    "copyright": "Cell Counter is a free, non-commercial research tool. Third-party notices are included.",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "bundle/**/*"
    ],
    "asar": true,
    "publish": null,
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "artifactName": "Cell-Counter-mac.${ext}"
    },
    "dmg": {
      "title": "Cell Counter"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Cell-Counter-windows-setup.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Science",
      "artifactName": "Cell-Counter-linux.${ext}"
    },
    "electronLanguages": [
      "en-US"
    ]
  }
}
